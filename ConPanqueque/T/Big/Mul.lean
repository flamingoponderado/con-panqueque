/-- `(lo3, hi3) := u * v + r + c`, from 32-bit halves. -/
def mulaccP : ProgHOL 64 :=
  .seq (.assign .local mA0 (.op .and [vv mU, .const 0xffffffff]))
  (.seq (.assign .local mA1 (.shift .lsr (vv mU) (.const 32)))
  (.seq (.assign .local mB0 (.op .and [vv mV, .const 0xffffffff]))
  (.seq (.assign .local mB1 (.shift .lsr (vv mV) (.const 32)))
  (.seq (.assign .local mP00 (.panop .mul [vv mA0, vv mB0]))
  (.seq (.assign .local mP01 (.panop .mul [vv mA0, vv mB1]))
  (.seq (.assign .local mP10 (.panop .mul [vv mA1, vv mB0]))
  (.seq (.assign .local mP11 (.panop .mul [vv mA1, vv mB1]))
  (.seq (.assign .local mMd (.op .add [vv mP01, vv mP10]))
  (.seq (.assign .local mM1 (.cmp .lower (vv mMd) (vv mP01)))
  (.seq (.assign .local mLo1 (.op .add [vv mP00, .shift .lsl (vv mMd) (.const 32)]))
  (.seq (.assign .local mC1 (.cmp .lower (vv mLo1) (vv mP00)))
  (.seq (.assign .local mHi1 (.op .add [.op .add [.op .add [vv mP11, .shift .lsr (vv mMd) (.const 32)],
      .shift .lsl (vv mM1) (.const 32)], vv mC1]))
  (.seq (.assign .local mLo2 (.op .add [vv mLo1, vv mR]))
  (.seq (.assign .local mC2 (.cmp .lower (vv mLo2) (vv mLo1)))
  (.seq (.assign .local mLo3 (.op .add [vv mLo2, vv mC]))
  (.seq (.assign .local mC3 (.cmp .lower (vv mLo3) (vv mLo2)))
  (.assign .local mHi3 (.op .add [.op .add [vv mHi1, vv mC2], vv mC3]))))))))))))))))))

def mulInner : ProgHOL 64 :=
  .while (.cmp .lower (vv mJ) (vv mLb))
    (.seq (.assign .local mV (.load .one (vv mQb)))
    (.seq (.assign .local mR (.load .one (vv mQr)))
    (.seq mulaccP
    (.seq (.store (vv mQr) (vv mLo3))
    (.seq (.assign .local mC (vv mHi3))
    (.seq (.assign .local mQb (.op .add [vv mQb, .const 8]))
    (.seq (.assign .local mQr (.op .add [vv mQr, .const 8]))
    (.assign .local mJ (.op .add [vv mJ, .const 1])))))))))

def mulOuter : ProgHOL 64 :=
  .while (.cmp .lower (vv mI) (vv mLa))
    (.seq (.assign .local mU (.load .one (vv mQa)))
    (.seq (.assign .local mC (.const 0))
    (.seq (.assign .local mQb (.op .add [vv mY, .const 8]))
    (.seq (.assign .local mQr (vv mQr0))
    (.seq (.assign .local mJ (.const 0))
    (.seq mulInner
    (.seq (.store (vv mQr) (vv mC))
    (.seq (.assign .local mQa (.op .add [vv mQa, .const 8]))
    (.seq (.assign .local mQr0 (.op .add [vv mQr0, .const 8]))
    (.assign .local mI (.op .add [vv mI, .const 1])))))))))))

def mulZero : ProgHOL 64 :=
  .while (.cmp .lower (vv mZi) (vv mN))
    (.seq (.store (vv mQz) (.const 0))
    (.seq (.assign .local mQz (.op .add [vv mQz, .const 8]))
    (.assign .local mZi (.op .add [vv mZi, .const 1]))))

def mulTrimE : ExpHOL 64 :=
  .op .add [vv mL, .panop .mul [.cmp .notEqual (vv mR) (.const 0), .op .sub [.op .add [vv mK, .const 1], vv mL]]]

def mulTrim : ProgHOL 64 :=
  .while (.cmp .lower (vv mK) (vv mN))
    (.seq (.assign .local mR (.load .one (vv mQr)))
    (.seq (.assign .local mL mulTrimE)
    (.seq (.assign .local mQr (.op .add [vv mQr, .const 8]))
    (.assign .local mK (.op .add [vv mK, .const 1])))))

def mulCore (C : Ctx) : ProgHOL 64 :=
  .seq (.assign .local mLa (.load .one (vv mX)))
  (.seq (.assign .local mLb (.load .one (vv mY)))
  (.seq (.assign .local mN (.op .add [vv mLa, vv mLb]))
  (allocP C mO (.panop .mul [.op .add [vv mN, .const 2], .const 8])
  (.seq (.assign .local mQz (.op .add [vv mO, .const 8])) (.seq (.assign .local mZi (.const 0))
  (.seq mulZero
  (.seq (.assign .local mQa (.op .add [vv mX, .const 8]))
  (.seq (.assign .local mQr0 (.op .add [vv mO, .const 8])) (.seq (.assign .local mI (.const 0))
  (.seq mulOuter
  (.seq (.assign .local mK (.const 0)) (.seq (.assign .local mL (.const 0))
  (.seq (.assign .local mQr (.op .add [vv mO, .const 8]))
  (.seq mulTrim
  (.seq (.store (vv mO) (vv mL))
  (.return (vv mO)))))))))))))))))

def mulLocals : List MlS := [mLa, mLb, mN, mO, mQz, mZi, mI, mJ, mQa, mQb, mQr, mQr0, mU, mV, mR, mC,
  mA0, mA1, mB0, mB1, mP00, mP01, mP10, mP11, mMd, mM1, mLo1, mC1, mHi1, mLo2, mC2, mLo3, mC3, mHi3, mK, mL]
def mulParams : List MlS := [mX, mY]
def mulBody (C : Ctx) : ProgHOL 64 := prologue mulLocals (mulCore C)

