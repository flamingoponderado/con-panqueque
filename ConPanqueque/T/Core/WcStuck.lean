@[simp] theorem wt_iK_ne_pH : iK ≠ pH := by decide
@[simp] theorem wt_pH_ne_iK : pH ≠ iK := by decide

def ioParams : List MlS := [kFu, kD, iC, iU, iQ, iA, iK]
def wstLocals : List MlS := [lFl, lDh, lDt, lDg, lDi, lRp, lRn, tC, tU, tW, tQ, tT, tLp, tLl, tM, tA, tLen, tO, tR]

def wstDone : ProgHOL 64 := .return (.shift .lsl (vv sE) (.const 1))

def wstCore (C : Ctx) : ProgHOL 64 :=
  .ite (tagIsE sH 3)
    (.seq (.assign .local lFl (vv lFle)) (.seq (.assign .local lDh (vv sH)) (.seq eViewP
    (.seq (.assign .local tC (.load .one (vv lRp))) (.seq (.assign .local tU (.load .one (.op .add [vv lRp, .const 8])))
    (envFindP C tW (vv tC)
    (.ite (.cmp .equal (vv tW) (.const 0)) wstDone
    (.seq (.assign .local tQ (.op .sub [vv tW, .const 1])) (.seq (.assign .local tT (.load .one (vv tQ)))
    (.ite (.cmp .notEqual (vv tT) (.const 5)) wstDone
    (.seq (.assign .local tLp (.load .one (.op .add [vv tQ, .const 16])))
    (.seq (.assign .local tLl (.load .one (vv tLp)))
    (.seq (.assign .local lFl (vv lFls)) (.seq (.assign .local lDh (vv tU)) (.seq lsViewP
    (.ite (.cmp .notEqual (vv lRn) (vv tLl)) wstDone
    (.seq (.assign .local tM (.load .one (.op .add [vv tQ, .const 32])))
    (.seq (.call (some (some (.local, tA), none)) ExG.fGaa [.const (BitVec.ofNat 64 coreWalkFuel), vv sE])
    (.seq (.assign .local tLen (.load .one (vv tA)))
    (.ite (.cmp .lower (vv tLen) (.op .add [vv tM, .const 1])) wstDone
    (.seq (.call (some (some (.local, tO), none)) fIota
      [vv kFu, vv kD, vv tC, vv tU, vv tQ, vv tA, .op .add [vv tM, .const 1]])
    (.ite (.cmp .equal (vv tO) (.const 0)) wstDone
    (.seq (.call (some (some (.local, tR), none)) ExK.fMka
      [.op .sub [vv tO, .const 1], vv tA, .op .add [vv tM, .const 1], vv tLen])
      (.return (.op .add [.shift .lsl (vv tR) (.const 1), .const 1])))))))))))))))))))))))))
    wstDone

def wstBody (C : Ctx) : ProgHOL 64 := prologue wstLocals (wstCore C)

end ConPanqueque.T.WC
