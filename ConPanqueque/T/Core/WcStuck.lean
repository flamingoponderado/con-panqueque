/-!
# `whnfStuck`: the ι step at a stuck spine

At a constant head that is a stored recursor with its own number of levels, applied to at least `mI + 1`
arguments: `iotaRecAt` (a function given by its spec) on the first `mI + 1`, and a fired reduct applied to the
rest. Otherwise the spine is its own answer.
-/

namespace ConPanqueque.T.WC

open ConPanqueque.T ConPanqueque.T.Ex ConPanqueque.T.Knot ConPanqueque.T.Big
open ConPanqueque.V.Enc

theorem viewConst_of_view {st : EStore} {i : EIdx} {n : NIdx} {us : LsIdx}
    (htg : i.tag = ETag.const) (h : st.view i = some (.const n us)) : st.viewConst i = some (n, us) := by
  cases hc : st.viewConst i with
  | some p =>
    obtain ⟨n', us'⟩ := p
    have := ConRon.Bridge.view_of_viewConst htg hc
    rw [h] at this; cases this; rfl
  | none =>
    exfalso
    revert h hc
    simp only [EStore.view, EStore.viewConst, EStore.persGetConst]
    split <;> [skip; split] <;> simp [ETables.get, ETables.getConst, htg] <;>
      (simp only [show ETag.const ≠ ETag.bvar by decide, show ETag.const ≠ ETag.fvar by decide,
        show ETag.const ≠ ETag.sort by decide, ite_false]; intro h1 h2; rw [h2] at h1; simp at h1)

theorem viewLsLen_run (us : LsIdx) (s : AState) (v : LsNodeView) (hv : s.store.lss.view us = some v) :
    viewLsLen us s = .ok (some v.length, s) := by
  show Except.ok (s.store.lss.viewLen us, s) = _
  rw [ConRon.Bridge.Core.lsStore_viewLen_eq, hv]; rfl


