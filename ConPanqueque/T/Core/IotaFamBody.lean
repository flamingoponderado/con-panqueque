def fmLocals : List MlS := [fmIsK, fmRp, fmMI, fmKs, fmJs, fmCn, fmInd, fmNc, fmAg, fmL, fmC, fmE, fmA, fmML, fmT2, fmMq, fmAl, fmD, fmNm, fmTy, fmTc, fmZ, fmI, fmT3, fmQ, fmX, lCn, lSrc, lDst, lCi, lCz]

def fmCore (C : Ctx) : ProgHOL 64 :=
  (.seq (.assign .local fmIsK (.load .one (.op .add [vv iQ, .const 48])))
  (.seq (.assign .local fmRp (.load .one (.op .add [vv iQ, .const 40])))
  (.seq (.assign .local fmMI (.op .sub [vv iK, .const 1]))
  (.seq (.assign .local fmKs (.load .one (.op .add [vv iQ, .const 16])))
  (.seq (.assign .local fmJs (.load .one (.op .add [vv ioQj, .const 16])))
  (.seq (.assign .local fmCn (.load .one (.op .add [vv ioQj, .const 32])))
  (.seq (.assign .local fmInd (.load .one (.op .add [vv ioQj, .const 48])))
  (.seq (.call (some (some (.local, fmNc), none)) fNc [vv fmIsK, vv fmInd, vv ioRq, vv fmJs])
  (.ite (vv fmNc) (.return (.const 1))
  (takeCopyP C fmAg iA iK
  (.seq (.call (some (some (.local, fmL), none)) fRf [vv ioRq, vv fmKs, vv iU, vv fmJs])
  (.seq (.call (some (some (.local, fmC), none)) fC3 [vv kFu, vv kD, vv fmIsK, vv fmInd, vv fmL])
  (.ite (.cmp .equal (vv fmC) (.const 0)) (.return (.const 1))
  (.seq (.call (some (some (.local, fmE), none)) LLeq.fLsGo [vv ioUj, vv fmL, .const 0])
  (.ite (.cmp .equal (vv fmE) (.const 0)) hang
  (.ite (.cmp .equal (vv fmE) (.const 1)) (.return (.const 0))
  (.seq (.call (some (some (.local, fmA), none)) fFa [vv ioRq, vv fmKs, vv iU, vv fmAg, vv fmRp, vv fmCn])
  (.seq (.assign .local fmML (.load .one (vv ioMa)))
  (.seq (.assign .local fmT2 (.cmp .lower (vv fmCn) (vv fmML)))
  (.seq (.assign .local fmMq (.op .add [vv fmML, .op .and [.op .sub [vv fmCn, vv fmML], .op .sub [.const 0, vv fmT2]]]))
  (.seq (.assign .local fmAl (.load .one (vv fmA)))
  (.seq (.call (some (some (.local, fmD), none)) fDl
      [vv kFu, vv kD, .op .add [vv ioMa, .const 8], vv fmMq, .op .add [vv fmA, .const 8], vv fmAl])
  (.ite (.cmp .equal (vv fmD) (.const 0)) (.return (.const 0))
  (.seq (.assign .local fmNm (.load .one (.op .add [vv ioQj, .const 8])))
  (.seq (.assign .local fmTy (.load .one (.op .add [vv ioQj, .const 24])))
  (.seq (.call (some (some (.local, fmTc), none)) CT.fCT [vv fmNm, vv fmJs, vv fmTy, vv ioUj])
  (allocP C fmZ (.const 8) (.seq (.store (vv fmZ) (.const 0))
  (.seq (.call (some (some (.local, fmI), none)) fIc [vv kFu, vv kD, vv fmTc, .op .add [vv ioMa, .const 8], vv fmML,
      vv fmZ, .const 0])
  (.ite (.cmp .equal (vv fmI) (.const 0)) (.return (.const 0))
  (.seq (.assign .local fmT3 (.cmp .lower (vv fmRp) (vv fmMI)))
  (.seq (.assign .local fmQ (.op .add [vv fmMI, .op .and [.op .sub [vv fmRp, vv fmMI], .op .sub [.const 0, vv fmT3]]]))
  (.seq (.call (some (some (.local, fmX), none)) fIx [vv kFu, vv kD, vv fmMI, vv fmRp, vv fmCn, vv fmTc,
      .op .add [vv ioMa, .const 8], vv fmML, .op .add [.op .add [vv fmAg, .const 8], .shift .lsl (vv fmQ) (.const 3)],
      .op .sub [vv fmMI, vv fmQ]])
    (.return (vv fmX)))))))))))))))))))))))))))))))))))

def fmBody (C : Ctx) : ProgHOL 64 := prologue fmLocals (fmCore C)

section
variable {σ : Type}

theorem fm_none (C : Ctx) (vals : List (BitVec 64)) :
    ∀ x, x ∈ fmLocals → (ctxEnv C ++ fmParams.zip vals).get x = none :=
  Knot.params_none C fmLocals fmParams vals (by decide) (by decide)

/-- An optional verdict, the heap extended, any final state. -/
def PostOBX (C : Ctx) (o : Option Bool) (w : BitVec 64) (s' : AState) (st : PState σ) : Prop :=
  ∃ H', C.H <+: H' ∧ w = LLeq.obW o ∧ SR (ctxH C H') s' st

theorem fm_e (C : Ctx) (o i : Nat) : ecell C o + BitVec.ofNat 64 (8 * i) = ecell C (o + i) := ecell_add C o i

structure FmCodes (C : Ctx) : Prop where
  nc : NcCodes C
  ncf : C.code.lookup fNc = some (ncParams.map (fun p => (p, ShapeHOL.one)), ncBody C, .one)
  rf : C.code.lookup fRf = some (rfParams.map (fun p => (p, ShapeHOL.one)), rfBody C, .one)
  c3 : C.code.lookup fC3 = some (c3Params.map (fun p => (p, ShapeHOL.one)), c3Body C, .one)
  ls : C.code.lookup LLeq.fLsGo = some (LLeq.lsParams.map (fun p => (p, ShapeHOL.one)), LLeq.lsGoBody, .one)
  fa : C.code.lookup fFa = some (faParams.map (fun p => (p, ShapeHOL.one)), faBody C, .one)
  dl : DlCodes C
  ct : C.code.lookup CT.fCT = some (CV.cvParams.map (fun p => (p, ShapeHOL.one)), CT.ctBody C, .one)
  ic : IcCodes C
  ix : IxCodes C
  ixf : C.code.lookup fIx = some (ixParams.map (fun p => (p, ShapeHOL.one)), ixBody, .one)

theorem fm_spec (ra : ConPanqueque.Hash.RuntimeAssumptions) (mode : ConLeche.CheckMode)
    (hv : mode.verifiedChecks = true) (n : Nat) (C : Ctx) (hok : CtxOK C) (hc : FmCodes C) (d : Nat)
    (hI : ∀ (H : List (BitVec 64)) s1, C.H <+: H → ∀ e', Callee (σ := σ) (ctxH C H) kParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW e'] (inferE C fIB) s1 ((knot mode C n).infer d e')
      (PostK (ctxH C H)))
    (hD : ∀ (H : List (BitVec 64)) s1, C.H <+: H → ∀ a b, Callee (σ := σ) (ctxH C H) dParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW a, Enc.idxW b] (dE C) s1 ((knot mode C n).defeq d a b)
      (PostB (ctxH C H)))
    (s : AState) (c : NIdx) (us : LsIdx) (cv : IConstantVal) (mI rP : Nat) (isK : Bool) (rules : List IRecRule)
    (q : Nat) (hci : CIE C.EB C.EH q (.recInfo cv mI rP isK rules))
    (sargs : List EIdx) (oa : Nat) (hba : BlkAt C.H oa (sargs.map Enc.idxW)) (hle : mI + 1 ≤ sargs.length)
    (hsl : sargs.length < 2 ^ 58)
    (usj : LsIdx) (qj : Nat) (cvj : IConstantVal) (cnP nF : Nat) (ind : NIdx)
    (hcij : CIE C.EB C.EH qj (.ctorInfo cvj cnP nF ind)) (qr : Nat) (rl : IRecRule) (hrule : RuleE C.EB C.EH qr rl)
    (om : Nat) (margs : List EIdx) (hml : margs.length < 2 ^ 58)
    (Q : AState → Prop) (hq : Q s)
    (hRf : ∀ H' s1 ok oj, C.H <+: H' → Q s1 → EBlk C.EH ok (cv.levelParams.map Enc.idxW) →
      EBlk C.EH oj (cvj.levelParams.map Enc.idxW) →
      SpecR (σ := σ) (Pre (ctxH C H') s1 (rfParams.zip [ecell C qr, ecell C ok, Enc.idxW us, ecell C oj])) (rfBody C) s1
        (recFireLevels rl cv.levelParams us cvj.levelParams) (PostLI (ctxH C H')))
    (hQrf : ∀ s1 a s2, Q s1 → recFireLevels rl cv.levelParams us cvj.levelParams s1 = .ok (a, s2) → Q s2)
    (hC3 : ∀ H' s1 L, C.H <+: H' → Q s1 →
      SpecR (σ := σ) (Pre (ctxH C H') s1 (c3Params.zip [BitVec.ofNat 64 n, BitVec.ofNat 64 d, boolW isK, Enc.idxW ind,
        Enc.idxW L])) (c3Body C) s1 (iotaCase3At (knot mode C n) C.fe isK ind L) (PostB (ctxH C H')))
    (hQc3 : ∀ s1 L a s2, Q s1 → iotaCase3At (knot mode C n) C.fe isK ind L s1 = .ok (a, s2) → Q s2)
    (hLs : ∀ H' s1 L, C.H <+: H' → Q s1 →
      SpecR (σ := σ) (Pre (ctxH C H') s1 (LLeq.lsParams.zip [Enc.idxW usj, Enc.idxW L, BitVec.ofNat 64 0]))
        LLeq.lsGoBody s1 (lvlsEq? usj L) (PostOBX (ctxH C H')))
    (hQls : ∀ s1 L a s2, Q s1 → lvlsEq? usj L s1 = .ok (a, s2) → Q s2)
    (hFa : ∀ H' s1 ok oa', C.H <+: H' → Q s1 → EBlk C.EH ok (cv.levelParams.map Enc.idxW) →
      BlkAt H' oa' ((sargs.take (mI + 1)).map Enc.idxW) →
      SpecR (σ := σ) (Pre (ctxH C H') s1 (faParams.zip [ecell C qr, ecell C ok, Enc.idxW us, cellA C oa',
        BitVec.ofNat 64 rP, BitVec.ofNat 64 cnP])) (faBody C) s1
        (recFireArgs rl cnP cv.levelParams us (sargs.take (mI + 1)) rP) (PostA (ctxH C H')))
    (hQfa : ∀ s1 a s2, Q s1 → recFireArgs rl cnP cv.levelParams us (sargs.take (mI + 1)) rP s1 = .ok (a, s2) → Q s2)
    (hQdl : ∀ s1 xs ys a s2, Q s1 → defEqList (knot mode C n) C.fe d xs ys s1 = .ok (a, s2) → Q s2)
    (hCt : ∀ H' s1 oj, C.H <+: H' → Q s1 → EBlk C.EH oj (cvj.levelParams.map Enc.idxW) →
      SpecR (σ := σ) (Pre (ctxH C H') s1 (CV.cvParams.zip [Enc.idxW cvj.name, ecell C oj, Enc.idxW cvj.type,
        Enc.idxW usj])) (CT.ctBody C) s1 (constTyAt cvj usj) (PostK (ctxH C H')))
    (H : List (BitVec 64)) (hp : C.H <+: H) (hbm : BlkAt H om (margs.map Enc.idxW)) :
    SpecR (σ := σ) (Pre (ctxH C H) s (fmParams.zip [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW c, Enc.idxW us,
      ecell C q, cellA C oa, BitVec.ofNat 64 (mI + 1), Enc.idxW usj, ecell C qj, ecell C qr, cellA C om])) (fmBody C) s
      (iotaFam mode (knot mode C n) C.fe d cv us mI rP isK (sargs.take (mI + 1)) usj cvj cnP ind rl margs)
      (Knot.PostB (ctxH C H)) := by
  obtain ⟨⟨_, ⟨wk, hwk, ok, hwk', hks⟩, _⟩, _, ⟨hmiW, hmi⟩, ⟨hrpW, hrp⟩, hisK, _⟩ := id hci
  subst hwk'
  obtain ⟨⟨hnm, ⟨wj, hwj, oj, hwj', hjs⟩, hty⟩, _, ⟨hcnW, hcnb⟩, _, hind⟩ := id hcij
  subst hwj'
  refine specR_prologue (postB_locals _) (fm_none _ _) ?_
  unfold fmCore iotaFam
  simp only [hv, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
  refine specR_envLoadI fmIsK (.op .add [vv iQ, .const 48]) (q + 6) _ (by decide)
