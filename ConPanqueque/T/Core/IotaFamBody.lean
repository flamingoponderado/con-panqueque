  refine specR_envLoadI fmKs (.op .add [vv iQ, .const 16]) (q + 2) _ (by decide)
    (by simp +decide [sev, Env.get, fmParams, ctxEnv]; exact (show _ = ecell C (q + 2) by simpa using fm_e C q 2)) (by simpa using hwk : C.EH[q + 2]? = _) ?_
  refine specR_envLoadI fmJs (.op .add [vv ioQj, .const 16]) (qj + 2) _ (by decide)
    (by simp +decide [sev, Env.get, fmParams, ctxEnv]; exact (show _ = ecell C (qj + 2) by simpa using fm_e C qj 2)) (by simpa using hwj : C.EH[qj + 2]? = _) ?_
  refine specR_envLoadI fmCn (.op .add [vv ioQj, .const 32]) (qj + 4) _ (by decide)
