    refine specR_callNIH (C := C) swXa ExG.fGaa [pFu, pH] [.const (BitVec.ofNat 64 coreWalkFuel), vv swA] (ExG.gaaBody C)
      [BitVec.ofNat 64 coreWalkFuel, Enc.idxW a] (by decide) rfl (by decide) hc.gaa
      ⟨rfl, by simp +decide [Env.get, swParams, ctxEnv], trivial⟩
      (PostA C) (fun xs w _ H1 => ∃ o1, w = cellA C o1 ∧ BlkAt H1 o1 (xs.map Enc.idxW))
