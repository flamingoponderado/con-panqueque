theorem cp_spec (ra : ConPanqueque.Hash.RuntimeAssumptions) (mode : ConLeche.CheckMode) (n : Nat) (C : Ctx)
    (hok : CtxOK C) (hc : SetCodes C)
    (hIO : ∀ (H : List (BitVec 64)) s1 d' e', C.H <+: H → Callee (σ := σ) (ctxH C H) kParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW e'] (inferIOE C fIOB) s1 ((knot mode C n).inferIO d' e')
      (PostK (ctxH C H)))
    (hW : ∀ (H : List (BitVec 64)) s1 d' e', C.H <+: H → Callee (σ := σ) (ctxH C H) kParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW e'] (whnfE C fWB) s1 ((knot mode C n).whnf d' e')
      (PostK (ctxH C H)))
    (hD : ∀ (H : List (BitVec 64)) s1 d' a b, C.H <+: H → Callee (σ := σ) (ctxH C H) dParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW a, Enc.idxW b] (dE C) s1 ((knot mode C n).defeq d' a b)
      (PostB (ctxH C H)))
    (hSW : ∀ (H : List (BitVec 64)) s1 d' a b w, C.H <+: H → SpecR (σ := σ) (Pre (ctxH C H) s1 (swParams.zip
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW a, Enc.idxW b, Enc.idxW w])) (swBody C) s1
      (structEtaCertWith (knot mode C n) C.fe d' a b w) (PostB (ctxH C H)))
    (hES : ∀ (H : List (BitVec 64)) s1 a, C.H <+: H → SpecR (σ := σ) (Pre (ctxH C H) s1 (esParams.zip [Enc.idxW a]))
      (esBody C) s1 (etaCtorShape C.fe a) (PostB (ctxH C H)))
    (hEP : ∀ (H : List (BitVec 64)) s1 a, C.H <+: H → SpecR (σ := σ) (Pre (ctxH C H) s1 (epParams.zip [Enc.idxW a]))
      (epBody C) s1 (etaCtorPartial C.fe a) (PostONat (ctxH C H))) :
    ∀ (H : List (BitVec 64)) (s : AState) (d : Nat), d < 2 ^ 64 → ∀ (k : Nat) (a b : EIdx), C.H <+: H → k + 1 < 2 ^ 64 →
      SpecR (σ := σ) (Pre (ctxH C H) s (cpParams.zip [BitVec.ofNat 64 n, BitVec.ofNat 64 d, BitVec.ofNat 64 k,
        Enc.idxW a, Enc.idxW b])) cpBody s (structEtaCertPartial (knot mode C n) C.fe d k a b) (PostB (ctxH C H)) := by
  intro H s d hd k a b hpH hk
  refine specR_prologue (postB_locals _) (Knot.params_none _ [cpN, cpTa, cpTb, cpQ, cpR] cpParams _ (by decide) (by decide)) ?_
  unfold structEtaCertPartial
  refine specR_callNIH (C := ctxH C H) cpN fNu [nuE] [vv cpB] nuBody
    [Enc.idxW b] (by decide) rfl (by decide) hc.nu
    ⟨by simp +decide [Env.get, cpParams, ctxEnv], trivial⟩
    (PostB (ctxH C H)) (fun r_ w _ _ => w = boolW r_) (fun r_ w s' st ⟨H', hp', hw, hsr⟩ => ⟨H', hp', hw, hsr⟩)
    (fun u hu _ hlk => Knot.specR_of_pre u (pre_of_lookups hu [nuE] _ rfl hlk) (nu_spec (ctxH C H) hc.gaf s b))
    (fun g w1 s1 H1 hp1 hw1 => ?_)
  subst hw1
  cases g
  · refine specR_ifI _ 0 (by simp [boolW]) (fun h => absurd rfl h) (fun _ => ?_)
    simp only [Bool.not_false, ↓reduceIte]
    exact specR_returnI _ 0 rfl (fun t ht => ⟨H1, hp1, rfl, sr_of_eq ht.sr rfl rfl rfl rfl⟩)
  refine specR_ifI _ 1 (by simp [boolW]) (fun _ => ?_) (fun h => absurd h (by decide))
  simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
  refine Big.specR_callKC (C := ctxH C H1) cpTa fIO kParams [vv kFu, vv kD, vv cpA] (inferIOE C fIOB)
    [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW a] (by decide) rfl (by decide) hc.io
    ⟨by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], trivial⟩ (hIO H1 s1 d a (hpH.trans hp1)) (fun ta s2 H2 hp2 _ => ?_)
  refine Big.specR_callKC (C := ctxH C H2) cpTb fIO kParams [vv kFu, vv kD, vv cpB] (inferIOE C fIOB)
    [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW b] (by decide) rfl (by decide) hc.io
    ⟨by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], trivial⟩ (hIO H2 s2 d b (hpH.trans (hp1.trans hp2))) (fun tb s3 H3 hp3 _ => ?_)
  have hp3a : C.H <+: H3 := hpH.trans (hp1.trans (hp2.trans hp3))
  refine specR_callNIH (C := ctxH C H3) cpQ fD dParams [vv kFu, vv kD, vv cpTb, vv cpTa] (dE C)
    [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW tb, Enc.idxW ta] (by decide) rfl (by decide) hc.d
    ⟨by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], by simp, by simp, trivial⟩
    (PostB (ctxH C H3)) (fun r_ w _ _ => w = boolW r_) (fun r_ w s' st ⟨H', hp', hw, hsr⟩ => ⟨H', hp', hw, hsr⟩)
    (fun u hu _ hlk => hD H3 s3 d tb ta hp3a u hu (fun i hi _ => hlk i (by omega)))
    (fun q w4 s4 H4 hp4 hw4 => ?_)
  subst hw4
  have hp4b : H <+: H4 := hp1.trans (hp2.trans (hp3.trans hp4))
  cases q
  · refine specR_ifI _ 0 (by simp [boolW]) (fun h => absurd rfl h) (fun _ => ?_)
    simp only [Bool.false_eq_true, ↓reduceIte]
    exact specR_returnI _ 0 rfl (fun t ht => ⟨H4, hp4b, rfl, sr_of_eq ht.sr rfl rfl rfl rfl⟩)
  refine specR_ifI _ 1 (by simp [boolW]) (fun _ => ?_) (fun h => absurd h (by decide))
  simp only [↓reduceIte]
  refine specR_congr (m' := structEtaExpand (knot mode C n) C.fe k d a b ta >>= fun r => pure r) (by simp) ?_
  refine specR_callNIH (C := ctxH C H4) cpR fSx sxParams [vv kFu, vv cpK, vv kD, vv cpA, vv cpB, vv cpTa] sxBody
    [BitVec.ofNat 64 n, BitVec.ofNat 64 k, BitVec.ofNat 64 d, Enc.idxW a, Enc.idxW b, Enc.idxW ta] (by decide) rfl (by decide) hc.sx
    ⟨by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], by simp +decide [Env.get, cpParams, ctxEnv], by simp, trivial⟩
    (PostB (ctxH C H4)) (fun r_ w _ _ => w = boolW r_) (fun r_ w s' st ⟨H', hp', hw, hsr⟩ => ⟨H', hp', hw, hsr⟩)
    (fun u hu _ hlk => Knot.specR_of_pre u (pre_of_lookups hu sxParams _ rfl hlk) (sx_spec ra mode n C hok hc hIO hW hD hSW hES hEP k H4 s4 d hd a b ta (hp3a.trans hp4) hk))
    (fun r5 w5 s5 H5 hp5 hw5 => ?_)
  subst hw5
  exact specR_returnI _ (boolW r5) (by simp) (fun t ht => ⟨H5, hp4b.trans hp5, rfl, sr_of_eq ht.sr rfl rfl rfl rfl⟩)

theorem cc_spec (ra : ConPanqueque.Hash.RuntimeAssumptions) (mode : ConLeche.CheckMode) (n : Nat) (C : Ctx)
    (hok : CtxOK C) (hc : SetCodes C)
    (hIO : ∀ (H : List (BitVec 64)) s1 d' e', C.H <+: H → Callee (σ := σ) (ctxH C H) kParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW e'] (inferIOE C fIOB) s1 ((knot mode C n).inferIO d' e')
      (PostK (ctxH C H)))
    (hW : ∀ (H : List (BitVec 64)) s1 d' e', C.H <+: H → Callee (σ := σ) (ctxH C H) kParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW e'] (whnfE C fWB) s1 ((knot mode C n).whnf d' e')
      (PostK (ctxH C H)))
    (hD : ∀ (H : List (BitVec 64)) s1 d' a b, C.H <+: H → Callee (σ := σ) (ctxH C H) dParams
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW a, Enc.idxW b] (dE C) s1 ((knot mode C n).defeq d' a b)
      (PostB (ctxH C H)))
    (hSW : ∀ (H : List (BitVec 64)) s1 d' a b w, C.H <+: H → SpecR (σ := σ) (Pre (ctxH C H) s1 (swParams.zip
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d', Enc.idxW a, Enc.idxW b, Enc.idxW w])) (swBody C) s1
      (structEtaCertWith (knot mode C n) C.fe d' a b w) (PostB (ctxH C H)))
    (hES : ∀ (H : List (BitVec 64)) s1 a, C.H <+: H → SpecR (σ := σ) (Pre (ctxH C H) s1 (esParams.zip [Enc.idxW a]))
      (esBody C) s1 (etaCtorShape C.fe a) (PostB (ctxH C H)))
    (hEP : ∀ (H : List (BitVec 64)) s1 a, C.H <+: H → SpecR (σ := σ) (Pre (ctxH C H) s1 (epParams.zip [Enc.idxW a]))
      (epBody C) s1 (etaCtorPartial C.fe a) (PostONat (ctxH C H))) :
    ∀ (H : List (BitVec 64)) (s : AState) (d : Nat), d < 2 ^ 64 → ∀ (a b : EIdx), C.H <+: H →
      SpecR (σ := σ) (Pre (ctxH C H) s (ccParams.zip [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW a, Enc.idxW b]))
        ccBody s (structEtaCert (knot mode C n) C.fe d a b) (PostB (ctxH C H)) := by
  intro H s d hd a b hpH
  refine specR_prologue (postB_locals _) (Knot.params_none _ [ccX, ccR, ccY] ccParams _ (by decide) (by decide)) ?_
  unfold structEtaCert
  refine specR_callNIH (C := ctxH C H) ccX fEs esParams [vv ccA] (esBody C)
    [Enc.idxW a] (by decide) rfl (by decide) hc.es
    ⟨by simp +decide [Env.get, ccParams, ctxEnv], trivial⟩
    (PostB (ctxH C H)) (fun r_ w _ _ => w = boolW r_) (fun r_ w s' st ⟨H', hp', hw, hsr⟩ => ⟨H', hp', hw, hsr⟩)
    (fun u hu _ hlk => Knot.specR_of_pre u (pre_of_lookups hu esParams _ rfl hlk) (hES H s a hpH))
    (fun x w1 s1 H1 hp1 hw1 => ?_)
  subst hw1
  cases x
  · refine specR_ifI _ 0 (by simp [boolW]) (fun h => absurd rfl h) (fun _ => ?_)
    simp only [Bool.false_eq_true, ↓reduceIte]
    refine specR_callNIH (C := ctxH C H1) ccY fEp epParams [vv ccA] (epBody C) [Enc.idxW a] (by decide) rfl (by decide) hc.ep
      ⟨by simp +decide [Env.get, ccParams, ctxEnv], trivial⟩ (PostONat (ctxH C H1)) (fun o w _ _ => w = optWG (BitVec.ofNat 64) o ∧ ∀ k, o = some k → k + 1 < 2 ^ 64)
      (fun o w s' st ⟨H', hp', hw, hb, hsr⟩ => ⟨H', hp', ⟨hw, hb⟩, hsr⟩)
      (fun u hu _ hlk => Knot.specR_of_pre u (pre_of_lookups hu epParams _ rfl hlk) (hEP H1 s1 a (hpH.trans hp1)))
      (fun ok w2 s2 H2 hp2 ⟨hw2, hb2⟩ => ?_)
    subst hw2
    rcases ok with _ | k
    · refine specR_ifI _ 1 (by simp [sev, optWG, Flapjack.Compiler.Encoders.Asm.wordCmpHOL]) (fun _ => ?_) (fun h => absurd h (by decide))
      try dsimp only
      exact specR_returnI _ 0 rfl (fun t ht => ⟨H2, hp1.trans hp2, rfl, sr_of_eq ht.sr rfl rfl rfl rfl⟩)
    have hk1 := hb2 k rfl
    have hne : BitVec.ofNat 64 k + 1 ≠ 0 := by
      intro e; have := congrArg BitVec.toNat e; simp [BitVec.toNat_add] at this; omega
    refine specR_ifI _ 0 (by simp [sev, optWG, Flapjack.Compiler.Encoders.Asm.wordCmpHOL]; exact hne) (fun h => absurd rfl h) (fun _ => ?_)
    try dsimp only
    refine specR_congr (m' := structEtaCertPartial (knot mode C n) C.fe d k a b >>= fun r => pure r) (by simp) ?_
    refine specR_callNIH (C := ctxH C H2) ccR fScp cpParams [vv kFu, vv kD, .op .sub [vv ccY, .const 1], vv ccA, vv ccB] cpBody
      [BitVec.ofNat 64 n, BitVec.ofNat 64 d, BitVec.ofNat 64 k, Enc.idxW a, Enc.idxW b] (by decide) rfl (by decide) hc.scp
      ⟨by simp +decide [Env.get, ccParams, ctxEnv], by simp +decide [Env.get, ccParams, ctxEnv], by simp [sev, optWG]; exact BitVec.add_sub_cancel _ _, by simp +decide [Env.get, ccParams, ctxEnv], by simp +decide [Env.get, ccParams, ctxEnv], trivial⟩
      (PostB (ctxH C H2)) (fun r_ w _ _ => w = boolW r_) (fun r_ w s' st ⟨H', hp', hw, hsr⟩ => ⟨H', hp', hw, hsr⟩)
      (fun u hu _ hlk => Knot.specR_of_pre u (pre_of_lookups hu cpParams _ rfl hlk) (cp_spec ra mode n C hok hc hIO hW hD hSW hES hEP H2 s2 d hd k a b (hpH.trans (hp1.trans hp2)) hk1))
      (fun r3 w3 s3 H3 hp3 hw3 => ?_)
    subst hw3
    exact specR_returnI _ (boolW r3) (by simp) (fun t ht => ⟨H3, hp1.trans (hp2.trans hp3), rfl, sr_of_eq ht.sr rfl rfl rfl rfl⟩)
  refine specR_ifI _ 1 (by simp [boolW]) (fun _ => ?_) (fun h => absurd h (by decide))
  simp only [↓reduceIte]
  refine specR_congr (m' := structEtaFullAt (knot mode C n) C.fe d a b >>= fun r => pure r) (by simp) ?_
  refine specR_callNIH (C := ctxH C H1) ccR fSfa ybParams [vv kFu, vv kD, vv ccA, vv ccB] ybBody
    [BitVec.ofNat 64 n, BitVec.ofNat 64 d, Enc.idxW a, Enc.idxW b] (by decide) rfl (by decide) hc.sfa
    ⟨by simp +decide [Env.get, ccParams, ctxEnv], by simp +decide [Env.get, ccParams, ctxEnv], by simp +decide [Env.get, ccParams, ctxEnv], by simp +decide [Env.get, ccParams, ctxEnv], trivial⟩
    (PostB (ctxH C H1)) (fun r_ w _ _ => w = boolW r_) (fun r_ w s' st ⟨H', hp', hw, hsr⟩ => ⟨H', hp', hw, hsr⟩)
    (fun u hu _ hlk => Knot.specR_of_pre u (pre_of_lookups hu ybParams _ rfl hlk) (yb_spec mode n C hc hIO hW hD hSW hES hEP H1 s1 d a b (hpH.trans hp1)))
    (fun r2 w2 s2 H2 hp2 hw2 => ?_)
  subst hw2
  exact specR_returnI _ (boolW r2) (by simp) (fun t ht => ⟨H2, hp1.trans hp2, rfl, sr_of_eq ht.sr rfl rfl rfl rfl⟩)
end

