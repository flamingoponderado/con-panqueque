def ybParams : List MlS := [kFu, kD, ybA, ybB]
def ybBody : ProgHOL 64 := prologue [ybT, ybW, ybR] (.seq (.call (some (some (.local, ybT), none)) fIO [(vv kFu), (vv kD), (vv ybB)]) (.seq (.call (some (some (.local, ybW), none)) fW [(vv kFu), (vv kD), (vv ybT)]) (.seq (.call (some (some (.local, ybR), none)) fSw [(vv kFu), (vv kD), (vv ybA), (vv ybB), (vv ybW)]) (.return (vv ybR)))))
def yuParams : List MlS := [kFu, kD, yuA, yuB]
def yuBody : ProgHOL 64 := prologue [yuX, yuR] (.seq (.call (some (some (.local, yuX), none)) fEs [(vv yuA)]) (.ite (vv yuX) (.seq (.call (some (some (.local, yuR), none)) fSfa [(vv kFu), (vv kD), (vv yuA), (vv yuB)]) (.return (vv yuR))) (.return (.const 0))))
def sxParams : List MlS := [kFu, sxK, kD, sxA, sxB, sxT]
def sxLocals : List MlS := [lFl, lDh, lDt, lDg, lDi, lRp, lRn, sxR, sxDm, sxBd, sxF, sxA2, sxB2, sxO, sxD1, sxK1]
def sxBody : ProgHOL 64 := prologue sxLocals (.ite (.cmp .equal (vv sxK) (.const 0)) (.seq (.call (some (some (.local, sxR), none)) fSf [(vv kFu), (vv kD), (vv sxA), (vv sxB)]) (.return (vv sxR))) (.ite (.cmp .lower (vv kD) (.const (BitVec.ofNat 64 (2 ^ 62)))) (.ite (tagIsE sxT 6) (.seq (.assign .local lFl (vv lFle)) (.seq (.assign .local lDh (vv sxT)) (.seq eViewP (.seq (.assign .local sxDm (.load .one (vv lRp))) (.seq (.assign .local sxBd (.load .one (.op .add [(vv lRp), (.const 8)]))) (.seq (.call (some (some (.local, sxF), none)) fInternFVar [(vv sxDm), (vv kD)]) (.seq (.call (some (some (.local, sxA2), none)) fInternApp [(vv sxA), (vv sxF)]) (.seq (.call (some (some (.local, sxB2), none)) fInternApp [(vv sxB), (vv sxF)]) (.seq (.call (some (some (.local, sxO), none)) ExI.fInst1F [(.const (BitVec.ofNat 64 coreWalkFuel)), (vv sxBd), (vv sxF), (.const 0)]) (.seq (.assign .local sxD1 (.op .add [(vv kD), (.const 1)])) (.seq (.assign .local sxK1 (.op .sub [(vv sxK), (.const 1)])) (.seq (.call (some (some (.local, sxR), none)) fSx [(vv kFu), (vv sxK1), (vv sxD1), (vv sxA2), (vv sxB2), (vv sxO)]) (.return (vv sxR)))))))))))))) (.return (.const 0))) hang))
def cpParams : List MlS := [kFu, kD, cpK, cpA, cpB]
def cpBody : ProgHOL 64 := prologue [cpN, cpTa, cpTb, cpQ, cpR] (.seq (.call (some (some (.local, cpN), none)) fNu [(vv cpB)]) (.ite (vv cpN) (.seq (.call (some (some (.local, cpTa), none)) fIO [(vv kFu), (vv kD), (vv cpA)]) (.seq (.call (some (some (.local, cpTb), none)) fIO [(vv kFu), (vv kD), (vv cpB)]) (.seq (.call (some (some (.local, cpQ), none)) fD [(vv kFu), (vv kD), (vv cpTb), (vv cpTa)]) (.ite (vv cpQ) (.seq (.call (some (some (.local, cpR), none)) fSx [(vv kFu), (vv cpK), (vv kD), (vv cpA), (vv cpB), (vv cpTa)]) (.return (vv cpR))) (.return (.const 0)))))) (.return (.const 0))))
def ccParams : List MlS := [kFu, kD, ccA, ccB]
def ccBody : ProgHOL 64 := prologue [ccX, ccR, ccY] (.seq (.call (some (some (.local, ccX), none)) fEs [(vv ccA)]) (.ite (vv ccX) (.seq (.call (some (some (.local, ccR), none)) fSfa [(vv kFu), (vv kD), (vv ccA), (vv ccB)]) (.return (vv ccR))) (.seq (.call (some (some (.local, ccY), none)) fEp [(vv ccA)]) (.ite (.cmp .equal (vv ccY) (.const 0)) (.return (.const 0)) (.seq (.call (some (some (.local, ccR), none)) fScp [(vv kFu), (vv kD), (.op .sub [(vv ccY), (.const 1)]), (vv ccA), (vv ccB)]) (.return (vv ccR)))))))

structure SetCodes (C : Ctx) : Prop where
  gaf : C.code.lookup fGetAppFn = some ([(pFu, .one), (pH, .one)], getAppFnBody, .one)
  nu : C.code.lookup fNu = some ([(nuE, .one)], nuBody, .one)
  io : C.code.lookup fIO = some (pmap kParams, inferIOE C fIOB, .one)
  w : C.code.lookup fW = some (pmap kParams, whnfE C fWB, .one)
  d : C.code.lookup fD = some (pmap dParams, dE C, .one)
  sw : C.code.lookup fSw = some (swParams.map (fun p => (p, ShapeHOL.one)), swBody C, .one)
  es : C.code.lookup fEs = some (esParams.map (fun p => (p, ShapeHOL.one)), esBody C, .one)
  ep : C.code.lookup fEp = some (epParams.map (fun p => (p, ShapeHOL.one)), epBody C, .one)
  fv : C.code.lookup fInternFVar = some ([(lEty, .one), (lIw, .one)], fvarBody, .one)
  ap : C.code.lookup fInternApp = some ([(lEf, .one), (lEa, .one)], internAppBody, .one)
  i1 : C.code.lookup ExI.fInst1F = some ([pFu, pH, ExI.pV, ExI.pD].map (fun p => (p, ShapeHOL.one)), ExI.fastBody C, .one)
  i1c : ExI.Codes C (ExI.body C)
  sfa : C.code.lookup fSfa = some (ybParams.map (fun p => (p, ShapeHOL.one)), ybBody, .one)
  sf : C.code.lookup fSf = some (yuParams.map (fun p => (p, ShapeHOL.one)), yuBody, .one)
  sx : C.code.lookup fSx = some (sxParams.map (fun p => (p, ShapeHOL.one)), sxBody, .one)
  scp : C.code.lookup fScp = some (cpParams.map (fun p => (p, ShapeHOL.one)), cpBody, .one)

