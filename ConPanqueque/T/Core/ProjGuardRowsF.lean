def gwBody (C : Ctx) : ProgHOL 64 := prologue gwLocals
  (.seq (.assign .local gwC (.load .one (.op .add [(vv gwT), (.const 24)]))) (.seq (.assign .local gwNp (.load .one (.op .add [(vv gwT), (.const 16)]))) (.ite (.cmp .lower (.op .add [(vv gwNp), (vv gwI)]) (.const (BitVec.ofNat 64 (2 ^ 56)))) (envFindP C gwP (vv gwC) (.ite (.cmp .equal (vv gwP) (.const 0)) (.return (.const 0)) (.seq (.assign .local gwQp (.op .sub [(vv gwP), (.const 1)])) (.seq (.assign .local gwN (.load .one (.op .add [(vv gwQp), (.const 8)]))) (.seq (.assign .local gwL (.load .one (.op .add [(vv gwQp), (.const 16)]))) (.seq (.assign .local gwTy (.load .one (.op .add [(vv gwQp), (.const 24)]))) (.seq (.call (some (some (.local, gwCt), none)) CT.fCT [(vv gwN), (vv gwL), (vv gwTy), (vv gwUs)]) (allocP C gwE0 (.const 8) (.seq (.store (vv gwE0) (.const 0)) (.seq (.call (some (some (.local, gwO), none)) fOp [(vv gwE0), (vv gwNp), (vv gwCt), (.const 0)]) (.ite (.cmp .equal (vv gwO) (.const 0)) (.return (.const 0)) (.seq (.assign .local gwA (.load .one (vv gwO))) (.seq (.assign .local gwR (.load .one (.op .add [(vv gwO), (.const 8)]))) (.seq (.call (some (some (.local, gwF), none)) fPf [(vv gwI), (.const 0), (vv gwR)]) (.ite (.cmp .notEqual (vv gwF) (.const 0)) (.seq (.assign .local gwDm (.op .sub [(vv gwF), (.const 1)])) (.seq (.assign .local gwLa (.load .one (vv gwA))) (.seq (.call (some (some (.local, gwD), none)) ExQ.fIrr [(vv gwA), (.const 0), (vv gwLa), (.const (BitVec.ofNat 64 coreWalkFuel)), (vv gwDm), (vv gwI)]) (allocP C gwE1 (.const 8) (.seq (.store (vv gwE1) (.const 0)) (.seq (.assign .local gwX (.op .add [(vv gwNp), (vv gwI)])) (.seq (.call (some (some (.local, gwB1), none)) ExPre.fAppend [(vv gwE1), (vv gwX)]) (.seq (.call (some (some (.local, gwB2), none)) ExPre.fAppend [(vv gwB1), (vv gwD)]) (.return (vv gwB2)))))))))) (.seq (.assign .local gwLa (.load .one (vv gwA))) (.seq (.call (some (some (.local, gwR2), none)) ExQ.fIrr [(vv gwA), (.const 0), (vv gwLa), (.const (BitVec.ofNat 64 coreWalkFuel)), (vv gwR), (.const 0)]) (allocP C gwE2 (.const 8) (.seq (.store (vv gwE2) (.const 0)) (.seq (.call (some (some (.local, gwQ), none)) fGq [(vv gwI), (vv gwNp), (vv gwR2), (vv gwE2)]) (.return (vv gwQ)))))))))))))))))))))) hang)))

section
variable {σ : Type}

theorem gw_none (C : Ctx) (vals : List (BitVec 64)) :
    ∀ x, x ∈ gwLocals → (ctxEnv C ++ gwParams.zip vals).get x = none :=
  Knot.params_none C gwLocals gwParams vals (by decide) (by decide)

structure GwCodes (C : Ctx) : Prop where
  mg : C.code.lookup fMemoGet = some ([(pG, .one), (pLen, .one)], memoGetBody, .one)
  mp : C.code.lookup fMemoProbe = some ([(pG, .one), (pLen, .one)], memoProbeBody, .one)
  ct : C.code.lookup CT.fCT = some (CV.cvParams.map (fun p => (p, ShapeHOL.one)), CT.ctBody C, .one)
  op : OpCodes C
  gq : GqCodes C

end

