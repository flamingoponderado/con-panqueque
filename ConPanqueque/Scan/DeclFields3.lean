import ConPanqueque.Scan.RecEnds2
import ConPanqueque.Scan.DeclFields2
import ConPanqueque.Scan.SlotKinds

/-! # Declaration fields, read again from the record (generated by the field generator)

`recFun spec inits (vv (slotName k))` scans the record at `i` and returns slot `k`.  When
con-leche's record scanner accepts the record as `d`, the returned word is slot `k` of the slot
list that builds `d`, and the slots keep the spec's kinds. -/

open Flapjack Flapjack.Pancake.PanLang Flapjack.PanSemStateFiniteExact Flapjack.Basis.Pure.MlString
open ConPanqueque.Logic ConPanqueque.V

namespace ConPanqueque.Scan

open ConLeche.Frontend

section
variable {σ : Type}

theorem quotSlot_sound (t : PanSemStateFiniteExact 64 σ) (A : BitVec 64) (b : ByteArray) (hp : Plat b)
    (hb : BytesAt t A b.data.toList) (hc : ScanCodes t) (i : USize) (hi : i.toNat ≤ b.size)
    (lb : t.locals.lookup sB = some (.val (.word A)))
    (ln : t.locals.lookup sN = some (.val (.word (BitVec.ofNat 64 b.size))))
    (li : t.locals.lookup sI = some (.val (.word (BitVec.ofNat 64 i.toNat))))
    (k : Nat) (hk : k < 4) (d : DeclRec) (e0 : USize) (hd : scanQuotDecl b i = .ok d e0) :
    RetP t (recFun scanQuotDeclSpec [BitVec.ofNat 64 listSentinel, BitVec.ofNat 64 listSentinel, 0, 0] (vv (slotName k))) (fun w => ∃ slots', KindsOK [2, 1, 0, 0] slots' ∧ d = (fun sl => (DeclRec.quot ⟨(sl.getD 2 default).nat, (sl.getD 1 default).list, (sl.getD 3 default).nat⟩ (sl.getD 0 default).str)) slots' ∧
      ∀ hk' : k < slots'.length, SlotOK b w slots'[k]) := by
  unfold recFun
  apply retP_decsOf
  have hlk := recEntry_lookup [BitVec.ofNat 64 listSentinel, BitVec.ofNat 64 listSentinel, 0, 0] t
  have hks : ∀ e ∈ scanQuotDeclSpec.keys, ActOK 4 e.2.2 := by simp [scanQuotDeclSpec, ActOK]
  have e := recBody_spec (σ := σ) scanQuotDeclSpec 4 t A b hp hb hc hks (by decide) i hi [.s "", .l [], .n 0, .n 0] rfl (slotName k) (Or.inr ⟨k, hk, rfl⟩)
    ((recLocals [BitVec.ofNat 64 listSentinel, BitVec.ofNat 64 listSentinel, 0, 0]).foldl (fun s (x, w) => setVarHOLFinite x (.val (.word w)) s) t) rfl rfl rfl rfl rfl
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact lb)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact ln)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact li)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by intro x hx; simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl | rfl | rfl | rfl <;> exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]⟩)
    (by intro k hk; simp only [List.length_cons, List.length_nil] at hk
        rcases (show k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 by omega) with rfl | rfl | rfl | rfl
        · exact ⟨BitVec.ofNat 64 listSentinel, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨BitVec.ofNat 64 listSentinel, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩)
  refine retP_mono e ?_
  rintro w ⟨j, slots', hro, -, -, hsl⟩
  have hro' := hro
  unfold RecOut at hro'
  split at hro'
  · rename_i hbyte
    have hs : scanQuotDecl b i = .ok ((fun sl => (DeclRec.quot ⟨(sl.getD 2 default).nat, (sl.getD 1 default).list, (sl.getD 3 default).nat⟩ (sl.getD 0 default).str)) slots') j := by
      rw [scanQuotDecl, scanQuotDeclLoop_eq b _ (i + 1) true 0 "" [] 0 0 rfl, ite_eq_left hbyte, hro']; rfl
    rw [hd] at hs
    simp only [ScanRes.ok.injEq] at hs
    have hsp : SpecKinds scanQuotDeclSpec [2, 1, 0, 0] := by
      intro e he sl kd hw
      simp only [scanQuotDeclSpec, List.mem_cons, List.not_mem_nil, or_false] at he
      rcases he with rfl | rfl | rfl | rfl | rfl <;> simp only [VAct.wr, Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at hw <;>
        obtain ⟨rfl, rfl⟩ := hw <;> rfl
    have hK0 : KindsOK [2, 1, 0, 0] [.s "", .l [], .n 0, .n 0] := by
      refine ⟨rfl, fun k hk => ?_⟩
      simp only [List.length_cons, List.length_nil] at hk
      rcases (show k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 by omega) with rfl | rfl | rfl | rfl <;> rfl
    exact ⟨slots', objLoop_kinds scanQuotDeclSpec [2, 1, 0, 0] hsp b _ (i + 1) true 0 [.s "", .l [], .n 0, .n 0] rfl hK0 slots' j hro', hs.1,
      fun hk' => hsl k hk' rfl⟩
  · simp at hro'


end

end ConPanqueque.Scan
