section
variable {σ : Type}

theorem axiomdeclEnd_sound (t : PanSemStateFiniteExact 64 σ) (A : BitVec 64) (b : ByteArray) (hp : Plat b)
    (hb : BytesAt t A b.data.toList) (hc : ScanCodes t) (i : USize) (hi : i.toNat ≤ b.size)
    (lb : t.locals.lookup sB = some (.val (.word A)))
    (ln : t.locals.lookup sN = some (.val (.word (BitVec.ofNat 64 b.size))))
    (li : t.locals.lookup sI = some (.val (.word (BitVec.ofNat 64 i.toNat)))) :
    RetP t (recFun scanAxiomDeclSpec [0, BitVec.ofNat 64 listSentinel, 0, 0] (vv sI)) (fun w => ∃ (j : USize), w = BitVec.ofNat 64 j.toNat ∧ j.toNat ≤ b.size + 64 ∧
      ∃ r : DeclRec, scanAxiomDecl b i = .ok r j) := by
  unfold recFun
  apply retP_decsOf
  have hlk := recEntry_lookup [0, BitVec.ofNat 64 listSentinel, 0, 0] t
  have hks : ∀ e ∈ scanAxiomDeclSpec.keys, ActOK 4 e.2.2 := by simp [scanAxiomDeclSpec, ActOK]
  have e := recBody_spec (σ := σ) scanAxiomDeclSpec 4 t A b hp hb hc hks (by decide) i hi [.b false, .l [], .n 0, .n 0] rfl sI (Or.inl rfl)
    ((recLocals [0, BitVec.ofNat 64 listSentinel, 0, 0]).foldl (fun s (x, w) => setVarHOLFinite x (.val (.word w)) s) t) rfl rfl rfl rfl rfl
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact lb)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact ln)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact li)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by intro x hx; simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl | rfl | rfl | rfl <;> exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]⟩)
    (by intro k hk; simp only [List.length_cons, List.length_nil] at hk
        rcases (show k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 by omega) with rfl | rfl | rfl | rfl
        · exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨BitVec.ofNat 64 listSentinel, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩)
  refine retP_mono e ?_
  rintro w ⟨j, slots', hro, hjb, hw, -⟩
  refine ⟨j, hw rfl, hjb, ?_⟩
  unfold RecOut at hro
  rw [scanAxiomDecl, scanAxiomDeclLoop_eq b _ (i + 1) true 0 false [] 0 0 rfl]
  split at hro
  · rename_i hbyte; rw [ite_eq_left hbyte, hro]; exact ⟨_, rfl⟩
  · simp at hro

theorem quotdeclEnd_sound (t : PanSemStateFiniteExact 64 σ) (A : BitVec 64) (b : ByteArray) (hp : Plat b)
    (hb : BytesAt t A b.data.toList) (hc : ScanCodes t) (i : USize) (hi : i.toNat ≤ b.size)
    (lb : t.locals.lookup sB = some (.val (.word A)))
    (ln : t.locals.lookup sN = some (.val (.word (BitVec.ofNat 64 b.size))))
    (li : t.locals.lookup sI = some (.val (.word (BitVec.ofNat 64 i.toNat)))) :
    RetP t (recFun scanQuotDeclSpec [BitVec.ofNat 64 listSentinel, BitVec.ofNat 64 listSentinel, 0, 0] (vv sI)) (fun w => ∃ (j : USize), w = BitVec.ofNat 64 j.toNat ∧ j.toNat ≤ b.size + 64 ∧
      ∃ r : DeclRec, scanQuotDecl b i = .ok r j) := by
  unfold recFun
  apply retP_decsOf
  have hlk := recEntry_lookup [BitVec.ofNat 64 listSentinel, BitVec.ofNat 64 listSentinel, 0, 0] t
  have hks : ∀ e ∈ scanQuotDeclSpec.keys, ActOK 4 e.2.2 := by simp [scanQuotDeclSpec, ActOK]
  have e := recBody_spec (σ := σ) scanQuotDeclSpec 4 t A b hp hb hc hks (by decide) i hi [.s "", .l [], .n 0, .n 0] rfl sI (Or.inl rfl)
    ((recLocals [BitVec.ofNat 64 listSentinel, BitVec.ofNat 64 listSentinel, 0, 0]).foldl (fun s (x, w) => setVarHOLFinite x (.val (.word w)) s) t) rfl rfl rfl rfl rfl
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact lb)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact ln)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact li)
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2])
    (by intro x hx; simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl | rfl | rfl | rfl <;> exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]⟩)
    (by intro k hk; simp only [List.length_cons, List.length_nil] at hk
        rcases (show k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 by omega) with rfl | rfl | rfl | rfl
        · exact ⟨BitVec.ofNat 64 listSentinel, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨BitVec.ofNat 64 listSentinel, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩
        · exact ⟨0, by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2], by simp [SlotOK, natCap, bw, listSentinel]⟩)
  refine retP_mono e ?_
  rintro w ⟨j, slots', hro, hjb, hw, -⟩
  refine ⟨j, hw rfl, hjb, ?_⟩
  unfold RecOut at hro
  rw [scanQuotDecl, scanQuotDeclLoop_eq b _ (i + 1) true 0 "" [] 0 0 rfl]
  split at hro
  · rename_i hbyte; rw [ite_eq_left hbyte, hro]; exact ⟨_, rfl⟩
  · simp at hro


end

end ConPanqueque.Scan
