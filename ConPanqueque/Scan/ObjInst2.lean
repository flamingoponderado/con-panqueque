import ConPanqueque.Scan.ObjInst

/-! # The quotient record loop as an instance of `objLoop` (generated by scripts/gen_objinst.py). -/

namespace ConPanqueque.Scan

open ConLeche.Frontend

def scanQuotDeclSpec : ObjSpec := ⟨[(.kKind, 1, .str 0), (.kLevelParams, 2, .natList 1), (.kName, 4, .natSet 2), (.kType, 8, .natSet 3)], 15⟩

theorem scanQuotDeclLoop_eq (b : ByteArray) :
    ∀ msr (i : USize) (wm : Bool) (seen : UInt32) (kind : String) (lps : List Nat) (nm : Nat) (ty : Nat), b.size - i.toNat = msr →
      scanQuotDeclLoop b i wm seen kind lps nm ty =
        srMap (fun sl => (DeclRec.quot ⟨(sl.getD 2 default).nat, (sl.getD 1 default).list, (sl.getD 3 default).nat⟩ (sl.getD 0 default).str)) (objLoop scanQuotDeclSpec b i wm seen [.s kind, .l lps, .n nm, .n ty]) := by
  intro msr
  induction msr using Nat.strongRecOn with
  | _ msr ih =>
    intro i wm seen kind lps nm ty hn
    rw [scanQuotDeclLoop, objLoop]
    by_cases h : i < b.usize
    · rw [dite_eq_left h, dite_eq_left h]
      have hs := usizeStep b i h
      have hb := usizeInBounds b i h
      generalize b.uget i (usizeInBounds b i h) = c
      by_cases hw : isWs c
      · simp only [hw, ↓reduceIte]; exact ih _ (by omega) _ _ _ _ _ _ _ rfl
      simp only [hw, Bool.false_eq_true, ↓reduceIte]
      by_cases h125 : c = 125
      · subst h125
        simp only [beq_self_eq_true, ↓reduceIte]
        by_cases h1 : (wm && seen != 0) = true
        · simp [h1, srMap]
        · simp only [h1, Bool.false_eq_true, ↓reduceIte, scanQuotDeclSpec]
          split <;> simp_all [srMap, SVal.nat, SVal.list, SVal.str, SVal.bool, SVal.hint]
      have n125 : (c == 125) = false := beq_eq_false_iff_ne.mpr h125
      simp only [n125, Bool.false_eq_true, ↓reduceIte]
      by_cases h44 : c = 44
      · subst h44
        simp only [beq_self_eq_true, ↓reduceIte]
        cases wm
        · simp only [Bool.false_eq_true, ↓reduceIte]; exact ih _ (by omega) _ _ _ _ _ _ _ rfl
        · simp [srMap]
      have n44 : (c == 44) = false := beq_eq_false_iff_ne.mpr h44
      simp only [n44, Bool.false_eq_true, ↓reduceIte]
      by_cases h34 : c = 34
      · subst h34
        simp only [beq_self_eq_true, ↓reduceIte]
        cases wm
        · simp [srMap]
        simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
        generalize keyEnd b (i + 1) = ke
        by_cases hk0 : (ke == 0) = true
        · simp [hk0, srMap]
        simp only [hk0, Bool.false_eq_true, ↓reduceIte]
        generalize valueAt b i ke = v
        by_cases hv : (v == i) = true
        · simp [hv, srMap]
        simp only [hv, Bool.false_eq_true, ↓reduceIte]
        generalize keyAt b i (ke - (i + 1)) = k
        cases k <;> simp only [lookupKey, scanQuotDeclSpec, reduceCtorEq, ↓reduceIte] <;> try (simp [srMap]; done)
        case kKind =>
          split
          · simp [srMap]
          simp only [stepVal]
          cases hx : scanString b v with
          | err er => simp [srMap]
          | ok x e =>
            simp only
            by_cases hie : i < e
            · rw [dite_eq_left hie, dite_eq_left hie]
              have := USize.lt_iff_toNat_lt.mp hie
              rw [ih _ (by omega) e false _ _ _ _ _ rfl]
              simp only [applyUpd, List.set] <;> rfl
            · rw [dite_eq_right hie, dite_eq_right hie]; rfl
        case kLevelParams =>
          split
          · simp [srMap]
          simp only [stepVal]
          cases hx : scanNatList b v with
          | err er => simp [srMap]
          | ok x e =>
            simp only
            by_cases hie : i < e
            · rw [dite_eq_left hie, dite_eq_left hie]
              have := USize.lt_iff_toNat_lt.mp hie
              rw [ih _ (by omega) e false _ _ _ _ _ rfl]
              simp only [applyUpd, List.set] <;> rfl
            · rw [dite_eq_right hie, dite_eq_right hie]; rfl
        case kName =>
          split
          · simp [srMap]
          simp only [stepVal]
          generalize numEnd b v = e
          by_cases he : (e == v) = true
          · simp [he, srMap]
          simp only [he, Bool.false_eq_true, ↓reduceIte]
          by_cases hie : i < e
          · rw [dite_eq_left hie, dite_eq_left hie]
            have := USize.lt_iff_toNat_lt.mp hie
            rw [ih _ (by omega) e false _ _ _ _ _ rfl]
            simp only [applyUpd, List.set] <;> rfl
          · rw [dite_eq_right hie, dite_eq_right hie]; rfl
        case kType =>
          split
          · simp [srMap]
          simp only [stepVal]
          generalize numEnd b v = e
          by_cases he : (e == v) = true
          · simp [he, srMap]
          simp only [he, Bool.false_eq_true, ↓reduceIte]
          by_cases hie : i < e
          · rw [dite_eq_left hie, dite_eq_left hie]
            have := USize.lt_iff_toNat_lt.mp hie
            rw [ih _ (by omega) e false _ _ _ _ _ rfl]
            simp only [applyUpd, List.set] <;> rfl
          · rw [dite_eq_right hie, dite_eq_right hie]; rfl
      have n34 : (c == 34) = false := beq_eq_false_iff_ne.mpr h34
      simp [n34, srMap]
    · rw [dite_eq_right h, dite_eq_right h]; rfl


end ConPanqueque.Scan
