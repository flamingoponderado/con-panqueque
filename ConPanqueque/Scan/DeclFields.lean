      refine ⟨rfl, fun k hk => ?_⟩
      simp only [List.length_cons, List.length_nil] at hk
      rcases (show k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 by omega) with rfl | rfl | rfl | rfl | rfl <;> rfl
    exact ⟨slots', objLoop_kinds scanOpaqueDeclSpec [3, 1, 0, 0, 0] hsp b _ (i + 1) true 0 [.b false, .l [], .n 0, .n 0, .n 0] rfl hK0 slots' j hro', hs.1,
      fun hk' => hsl k hk' rfl⟩
