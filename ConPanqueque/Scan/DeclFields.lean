  apply retP_decsOf
  have hlk := recEntry_lookup [0, BitVec.ofNat 64 listSentinel, 0, 0, 0] t
  have hks : ∀ e ∈ scanOpaqueDeclSpec.keys, ActOK 5 e.2.2 := by simp [scanOpaqueDeclSpec, ActOK]
  have e := recBody_spec (σ := σ) scanOpaqueDeclSpec 5 t A b hp hb hc hks (by decide) i hi [.b false, .l [], .n 0, .n 0, .n 0] rfl (slotName k) (Or.inr ⟨k, hk, rfl⟩)
    ((recLocals [0, BitVec.ofNat 64 listSentinel, 0, 0, 0]).foldl (fun s (x, w) => setVarHOLFinite x (.val (.word w)) s) t) rfl rfl rfl rfl rfl
    (by rw [hlk]; simp (config := {decide := true}) [recLocals, slotName, slotNames, sB, sN, sI, sG, sW, sS, sC, sK, sV, sKK, sE2]; exact lb)
